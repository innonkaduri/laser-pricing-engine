[Unit]
Description=גיבוי טבלת המחירים ומסד המשתמשים של מנוע תמחור הלייזר
Documentation=file:///opt/laser/scripts/backup-tariff.sh
# היחידה המשרתת היא laser-pricing.service (אומת על הקופסה).

[Service]
Type=oneshot
# רץ כ-root כדי לכתוב ל-/var/backups — הקריאה מ-/var/lib/laser בלבד.
ExecStart=/opt/laser/scripts/backup-tariff.sh
Environment=TARIFF_PATH=/var/lib/laser/tariff.json
Environment=USERS_DB=/var/lib/laser/users.db
Environment=BACKUP_STATUS_FILE=/var/lib/laser/backup-status.json
Environment=BACKUP_DIR=/var/backups/laser-tariff
Environment=KEEP=60
# היעד שמוציא את הגיבוי מהקופסה. /var/backups יושב על אותו דיסק שהוא
# מגבה, ולכן הוא מגן על האפליקציה ולא על אובדן המכונה. התיקייה הזאת
# היא זו ש-`scripts/vps-backup-pull.sh` על המק של ינון מושך ממנה
# ב-09:00 ושומר 60 יום. שייכת לצינור של adi — הסקריפט לא יוצר אותה,
# ונכשל בקול אם היא נעלמה.
Environment=OFFBOX_DIR=/opt/adi-backups
