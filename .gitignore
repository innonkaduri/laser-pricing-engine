.DS_Store
node_modules/
.env
*.log

__pycache__/
.pytest_cache/
.venv/
*.pyc
tests/fixtures/

# פלט של כלי הדפדפן בבדיקות ידניות
.playwright-mcp/

# הטבלה החיה — המחירים האמיתיים של המשפחה.
# מחוץ למעקב משתי סיבות: היא לא צריכה להתפרסם בריפו הציבורי,
# ו-`git clean -fd` בשרת מוחק קבצים לא-מנוטרים שאינם ב-.gitignore.
# בלי השורה הזאת פקודה אחת מוחקת את כל מה שאבא הזין.
config/tariff.json

# מסד המשתמשים — גיבובי סיסמאות של ארבעת המשתמשים הפנימיים.
# מחוץ למעקב מאותן שתי סיבות כמו הטבלה: הריפו ציבורי, ו-`git clean -fd`
# מוחק קבצים לא-מנוטרים שאינם כאן.
config/users.db
config/users.db-journal
config/users.db-wal

# רישום השימוש — טלמטריה שנכתבת לדיסק. מחוץ למעקב מאותן שתי סיבות
# כמו הטבלה ומסד המשתמשים: הריפו ציבורי, ו-`git clean -fd` מוחק
# קבצים לא-מנוטרים שאינם כאן.
config/usage.jsonl

# היסטוריית ההצעות של המשתמשים — מסד sqlite שנכתב בזמן ריצה. מחוץ
# למעקב מאותן שתי סיבות כמו users.db: הריפו ציבורי, ו-`git clean -fd`
# מוחק קבצים לא-מנוטרים שאינם כאן.
config/quotes.db
config/quotes.db-journal
config/quotes.db-wal

# דיווח הגיבוי לדשבורד — נכתב על השרת בכל ריצה של הטיימר.
# בלי השורה הזאת הוא קובץ לא-מנוטר בעץ, והוא יעצור את ה-`git pull` הבא
# בדיוק כמו ש-scripts/backup-tariff.sh עצר את הקודם.
config/backup-status.json
.secrets/

# רעש של כלים על השרת ובמק. `npm ci` ו-pip יוצרים תיקיות כאלה, והן
# מופיעות ב-`git status` של הקופסה — מה שיכשיל כל בדיקת "העץ נקי"
# ברגע שהיא תהפוך לתנאי חוסם.
.cache/
.pytest_cache/
__pycache__/

# צילומי מסך מבדיקות עין. נוצרים בשורש בזמן עבודה, אינם חלק מהמוצר,
# והריפו ציבורי — אין סיבה לפרסם צילום של אתר מתחרה או של מסך בפיתוח.
shot-*.png
zammit-*.png

# תוצר של `pip install -e .`. נוצר מחדש בכל התקנה.
src/*.egg-info/
